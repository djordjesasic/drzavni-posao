# Non-secret settings of this series for docker compose (scripts pass it with
# --env-file after the shared .env). Secrets stay in .env on the mini PC.
DP_SERIES=drzavni-posao
# The series' data folder on the mini PC, mounted at /data.
DP_DATA_DIR=./data
# The series' embedding service port (127.0.0.1 only). DP_API_PORT comes from .env
# for this series; another series sets its own here (e.g. 8092).
DP_EMBED_PORT=8091
